{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m7mdehab.github.io/hieratic-ai/data/alignment/w9_rime/reference_geometry.schema.json",
  "title": "W9 RIME reference-only geometry packet",
  "type": "object",
  "required": ["schema_version", "reference_set_id", "source", "rights_boundary", "edition_reference", "geometry_regions", "scientific_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reference_set_id": {"const": "W9-RIME-CAT1883-CAT2095-RECTO-REFERENCE-GEOMETRY-v1"},
    "source": {
      "type": "object",
      "required": ["institution", "source_object_id", "physical_support_group", "view", "exact_file_url", "source_sha256", "source_dimensions", "acquisition_evidence_id"],
      "properties": {
        "institution": {"const": "Museo Egizio, Turin"},
        "source_object_id": {"const": "Cat.1883 + Cat.2095"},
        "physical_support_group": {"const": "Cat.1883 + Cat.2095 (one joined five-fragment support)"},
        "view": {"const": "recto as currently mounted, RIME Fig. 6"},
        "exact_file_url": {"const": "https://rivista.museoegizio.it/wp-content/themes/annotum-base/assets/articles/4418/content/6/original.tif"},
        "source_sha256": {"const": "c4b878ca5b6b6c22d0b4b1574d4f8e95072d651c38cb03d49f3cf73c5f6052b9"},
        "source_dimensions": {"const": [6585, 4718]},
        "acquisition_evidence_id": {"const": "W9-RIME-CAT1883-CAT2095-FIG6-RECTO-v1"}
      }, "additionalProperties": false
    },
    "rights_boundary": {
      "type": "object",
      "required": ["figure_image_license", "article_text_license", "line_text_included", "source_registry_status", "benchmark_overlap", "training_admission", "gold_or_transcription"],
      "properties": {
        "figure_image_license": {"const": "CC BY 2.0"},
        "article_text_license": {"const": "UNVERIFIED"},
        "line_text_included": {"const": false},
        "source_registry_status": {"const": "NOT_REGISTERED"},
        "benchmark_overlap": {"const": "UNRESOLVED_QUARANTINED"},
        "training_admission": {"const": "BLOCKED"},
        "gold_or_transcription": {"const": "NONE"}
      }, "additionalProperties": false
    },
    "edition_reference": {
      "type": "object",
      "required": ["citation", "url", "coordinate_source", "reference_only"],
      "properties": {
        "citation": {"const": "Martina Landrino, RIME 6 (2022), DOI 10.29353/rime.2022.4418"},
        "url": {"const": "https://rivista.museoegizio.it/article/papyrus-turin-cat-1883-cat-2095-a-new-edition-of-an-already-known-papyrus/"},
        "coordinate_source": {"const": "Fig. 6 image geometry and article §1.1 dimensions; pointers only, no published transcription reused"},
        "reference_only": {"const": true}
      }, "additionalProperties": false
    },
    "geometry_regions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["region_id", "coordinate_system", "source_bounds", "region_kind", "edition_pointer", "published_line_count", "mapping_state", "review_state", "gold_scoreable"],
        "properties": {
          "region_id": {"type": "string", "pattern": "^rime-recto-column-[1-3]$"},
          "coordinate_system": {"const": "original_image_pixels; origin top-left; left/top inclusive, right/bottom exclusive"},
          "source_bounds": {"type": "array", "prefixItems": [{"type":"integer","minimum":0,"maximum":6584},{"type":"integer","minimum":0,"maximum":4717},{"type":"integer","minimum":1,"maximum":6585},{"type":"integer","minimum":1,"maximum":4718}],"items":false,"minItems":4,"maxItems":4},
          "region_kind": {"const": "column_envelope_candidate"},
          "edition_pointer": {"type": "string", "pattern": "^RIME 6 [(]2022[)], §2[.]1[.][1-3] Col[.] [1-3]$"},
          "published_line_count": {"type": "integer", "enum": [4,12]},
          "mapping_state": {"const": "COLUMN_ENVELOPE_ONLY_NOT_LINE_ALIGNED"},
          "geometry_basis": {"const": "manual estimate from Fig. 6 scan using article's 410 mm support width and published column widths/gaps; not independently reviewed"},
          "review_state": {"const": "unreviewed"},
          "gold_scoreable": {"const": false}
        }, "additionalProperties": false
      }
    },
    "ambiguity_note": {"const": "Landrino discusses a disputed line-1 assignment between adjacent columns in §2.1.2; this packet preserves section pointers only and does not adjudicate line ordering or scope."},
    "data004_annotation_id": {"const": null},
    "line_level_alignment": {"const": false},
    "scientific_status": {"const": "REFERENCE_GEOMETRY_ONLY_NOT_ALIGNMENT_GOLD"}
  }, "additionalProperties": false
}
