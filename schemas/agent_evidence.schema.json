{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hieratic AI execution-agent evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "branch",
    "head_sha",
    "changed_files",
    "commands",
    "acceptance",
    "artifacts",
    "deviations",
    "unresolved_risks",
    "licensing_provenance",
    "self_awarded_progress"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^task/[A-Z]+-[0-9]{3}-[a-z0-9-]+$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "pull_request": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|(^|/)\\.\\.(/|$))"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "summary"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "met",
          "evidence_ref"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "met": {
            "type": "boolean"
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licensing_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "third_party_assets_added",
        "rights_review_status",
        "notes"
      ],
      "properties": {
        "third_party_assets_added": {
          "type": "boolean"
        },
        "rights_review_status": {
          "enum": [
            "no_external_assets",
            "approved_with_evidence",
            "unresolved",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_awarded_progress": {
      "const": false
    }
  }
}
