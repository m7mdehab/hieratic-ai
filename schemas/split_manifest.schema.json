{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m7mdehab.github.io/hieratic-ai/schemas/split_manifest.schema.json",
  "title": "Hieratic AI evaluation split manifest",
  "type": "object",
  "required": ["split_version", "generator_version", "seed", "profile_id", "source_metadata_version", "source_metadata_sha256", "generation_timestamp", "grouping_keys_used", "holdout_values", "assignments", "near_duplicate_review_queue", "statistics", "warnings"],
  "properties": {
    "split_version": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "profile_id": {"type": "string", "enum": ["PROFILE-DOC-HOLDOUT", "PROFILE-SCRIBE-HOLDOUT", "PROFILE-SOURCE-HOLDOUT", "PROFILE-PERIOD-HOLDOUT", "PROFILE-SEALED-TEST"]},
    "source_metadata_version": {"type": "string", "minLength": 1},
    "source_metadata_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "generation_timestamp": {"type": "string", "format": "date-time"},
    "grouping_keys_used": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "holdout_values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
    "near_duplicate_review_queue": {"type": "array", "items": {"$ref": "#/$defs/reviewPair"}},
    "statistics": {
      "type": "object",
      "required": ["item_counts", "document_counts", "dimension_counts", "known_scribe_counts", "excluded_or_quarantined_count", "warning_count"],
      "properties": {
        "item_counts": {"$ref": "#/$defs/partitionCounts"},
        "document_counts": {"$ref": "#/$defs/partitionCounts"},
        "dimension_counts": {"type": "object"},
        "known_scribe_counts": {"$ref": "#/$defs/partitionCounts"},
        "excluded_or_quarantined_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "sealed_test_policy": {"type": ["object", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "partitionCounts": {
      "type": "object",
      "required": ["train", "dev", "test", "excluded"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "dev": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "nullableString": {"type": ["string", "null"]},
    "nullableSha": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "assignment": {
      "type": "object",
      "required": ["item_id", "partition", "document_id", "page_id", "source_id", "source_object_id", "institution", "scribe_group", "period", "material_support", "genre_register", "image_sha256", "normalized_sha256", "perceptual_hash", "benchmark_quarantine", "exclusion_reason", "atomic_group_id"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "partition": {"type": "string", "enum": ["train", "dev", "test", "excluded"]},
        "document_id": {"type": "string", "minLength": 1},
        "page_id": {"$ref": "#/$defs/nullableString"},
        "source_id": {"type": "string", "minLength": 1},
        "source_object_id": {"$ref": "#/$defs/nullableString"},
        "institution": {"$ref": "#/$defs/nullableString"},
        "scribe_group": {"$ref": "#/$defs/nullableString"},
        "period": {"$ref": "#/$defs/nullableString"},
        "material_support": {"$ref": "#/$defs/nullableString"},
        "genre_register": {"$ref": "#/$defs/nullableString"},
        "image_sha256": {"$ref": "#/$defs/nullableSha"},
        "normalized_sha256": {"$ref": "#/$defs/nullableSha"},
        "perceptual_hash": {"$ref": "#/$defs/nullableString"},
        "benchmark_quarantine": {"type": "boolean"},
        "exclusion_reason": {"$ref": "#/$defs/nullableString"},
        "atomic_group_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reviewPair": {
      "type": "object",
      "required": ["left_item_id", "right_item_id", "method", "similarity", "review_status", "reviewer_id", "evidence_ref"],
      "properties": {
        "left_item_id": {"type": "string", "minLength": 1},
        "right_item_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "enum": ["perceptual_hash", "embedding_similarity", "manual", "other"]},
        "similarity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "review_status": {"type": "string", "enum": ["pending", "same_content", "distinct_content"]},
        "reviewer_id": {"type": ["string", "null"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
