{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://m7mdehab.github.io/hieratic-ai/schemas/annotation_review.schema.json","title":"Hieratic annotation expert review packet","type":"object","required":["schema_version","review_set_id","annotation_id","blinding","reviewers","cases"],
  "properties":{"schema_version":{"const":"1.0.0"},"review_set_id":{"type":"string","minLength":1},"annotation_id":{"type":"string","minLength":1},"blinding":{"type":"object","required":["enabled","predictions_visible","peer_decisions_visible"],"properties":{"enabled":{"type":"boolean"},"predictions_visible":{"type":"boolean"},"peer_decisions_visible":{"type":"boolean"}},"additionalProperties":false},"reviewers":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/reviewer"}},"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case"}}},"additionalProperties":false,
  "$defs":{
    "reviewer":{"type":"object","required":["reviewer_id","role","independence_group","conflict_of_interest","assignment_status"],"properties":{"reviewer_id":{"type":"string"},"role":{"enum":["annotator","reviewer","adjudicator"]},"independence_group":{"type":"string","minLength":1},"conflict_of_interest":{"type":"boolean"},"assignment_status":{"enum":["assigned","recused","completed"]}},"additionalProperties":false},
    "decision":{"type":"object","required":["decision_id","reviewer_id","outcome","selected_reading_id","acceptable_reading_ids","uncertainty_flags","confidence","rationale","evidence_ref","submitted_at","supersedes_decision_id"],"properties":{"decision_id":{"type":"string"},"reviewer_id":{"type":"string"},"outcome":{"enum":["certain_reading","alternative_reading","uncertain","illegible_damaged","missing_gold","editorial_restoration","adjudication_request"]},"selected_reading_id":{"type":["string","null"]},"acceptable_reading_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"uncertainty_flags":{"type":"array","items":{"enum":["ambiguous_sign","damage","lacuna","restoration","orthographic_variant","segmentation","missing_gold","other"]}},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"rationale":{"type":"string","minLength":1},"evidence_ref":{"type":"string","minLength":1},"submitted_at":{"type":"string","format":"date-time"},"supersedes_decision_id":{"type":["string","null"]}},"additionalProperties":false},
    "transition":{"type":"object","required":["event_id","from_state","to_state","event_type","actor_id","evidence_ref","occurred_at"],"properties":{"event_id":{"type":"string"},"from_state":{"enum":["draft","assigned","in_review","needs_adjudication","reviewed","adjudicated","closed"]},"to_state":{"enum":["draft","assigned","in_review","needs_adjudication","reviewed","adjudicated","closed"]},"event_type":{"enum":["assign_reviewers","start_review","submit_disagreement","submit_consensus","adjudicate","close_case"]},"actor_id":{"type":"string"},"evidence_ref":{"type":"string","minLength":1},"occurred_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "case":{"type":"object","required":["case_id","target_type","target_id","annotation_layer","annotation_gold_status","issue_flags","case_state","decisions","adjudication","state_history"],"properties":{"case_id":{"type":"string"},"target_type":{"enum":["line","sign","token"]},"target_id":{"type":"string"},"annotation_layer":{"enum":["grapheme_sequence","hieroglyphic_rendering","transliteration","normalized_representation","lemma_analysis","morphology","syntax","sign_identity","token_value"]},"annotation_gold_status":{"enum":["certain","uncertain_with_alternatives","illegible_unscorable","missing_annotation","adjudication_pending"]},"issue_flags":{"type":"array","items":{"enum":["damage","missing_gold","editorial_restoration","disputed_reading","none"]},"uniqueItems":true},"case_state":{"enum":["draft","assigned","in_review","needs_adjudication","reviewed","adjudicated","closed"]},"decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},"adjudication":{"type":["object","null"],"required":["adjudicator_id","outcome","selected_reading_id","rationale","evidence_ref","decided_at"],"properties":{"adjudicator_id":{"type":"string"},"outcome":{"enum":["certain_reading","alternative_reading","uncertain","illegible_damaged","missing_gold","editorial_restoration","unresolved"]},"selected_reading_id":{"type":["string","null"]},"rationale":{"type":"string","minLength":1},"evidence_ref":{"type":"string","minLength":1},"decided_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"state_history":{"type":"array","items":{"$ref":"#/$defs/transition"}}},"additionalProperties":false}
  }
