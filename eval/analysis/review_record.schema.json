{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/m7mdehab/hieratic-ai/blob/main/eval/analysis/review_record.schema.json",
  "title": "Hieratic AI evidence-linked error analysis record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "model_id",
    "dataset_version",
    "split_id",
    "document_id",
    "unit_id",
    "unit_type",
    "metric_id",
    "gold_status",
    "attribution_status",
    "primary_error",
    "error_codes",
    "severity",
    "sample_scope",
    "exposure_status",
    "score_status",
    "evidence_refs",
    "strata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "split_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit_type": {
      "enum": [
        "item",
        "sign",
        "region",
        "line",
        "passage",
        "document"
      ]
    },
    "metric_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "gold_status": {
      "enum": [
        "certain",
        "uncertain_with_alternatives",
        "illegible_unscorable",
        "missing_annotation",
        "adjudication_pending"
      ]
    },
    "attribution_status": {
      "enum": [
        "observed",
        "adjudicated",
        "disputed"
      ]
    },
    "primary_error": {
      "type": "string",
      "minLength": 1
    },
    "error_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ]
    },
    "sample_scope": {
      "enum": [
        "development",
        "public_eval",
        "sealed_aggregate"
      ]
    },
    "exposure_status": {
      "enum": [
        "clean",
        "suspected",
        "confirmed",
        "unknown"
      ]
    },
    "score_status": {
      "enum": [
        "scored",
        "excluded",
        "pending"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(artifact:|sha256:|https://).+"
      },
      "uniqueItems": true
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "taxonomy_version": {
      "const": "1.0.0"
    },
    "metric_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "upstream_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scribe": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "damage": {
          "type": "string",
          "minLength": 1
        },
        "layout_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attribution_status": {
            "const": "adjudicated"
          }
        },
        "required": [
          "attribution_status"
        ]
      },
      "then": {
        "required": [
          "reviewer_id",
          "reviewed_at"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gold_status": {
            "enum": [
              "missing_annotation",
              "illegible_unscorable",
              "adjudication_pending"
            ]
          }
        },
        "required": [
          "gold_status"
        ]
      },
      "then": {
        "properties": {
          "score_status": {
            "enum": [
              "excluded",
              "pending"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exposure_status": {
            "const": "confirmed"
          }
        },
        "required": [
          "exposure_status"
        ]
      },
      "then": {
        "properties": {
          "score_status": {
            "enum": [
              "excluded",
              "pending"
            ]
          }
        }
      }
    }
  ]
}
