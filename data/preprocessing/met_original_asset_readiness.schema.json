{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hieratic-ai.invalid/schemas/met-original-asset-readiness-1.0.0.json",
  "title": "Offline Met original-asset readiness assessment",
  "type": "object",
