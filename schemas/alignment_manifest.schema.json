{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://m7mdehab.github.io/hieratic-ai/schemas/alignment_manifest.schema.json","title":"Image-to-text alignment manifest","type":"object",
  "required":["schema_version","alignment_set_id","acquisition_manifest_id","acquisition_item_source_object_id","annotation_id","alignments"],
  "properties":{"schema_version":{"const":"1.0.0"},"alignment_set_id":{"type":"string","minLength":1},"acquisition_manifest_id":{"type":"string","minLength":1},"acquisition_item_source_object_id":{"type":"string","minLength":1},"annotation_id":{"type":"string","minLength":1},"alignments":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/alignment"}}},"additionalProperties":false,
  "$defs":{
    "target":{"type":"object","required":["target_type","target_id"],"properties":{"target_type":{"enum":["line","sign","token"]},"target_id":{"type":"string","minLength":1}},"additionalProperties":false},
    "hypothesis":{"type":"object","required":["hypothesis_id","targets","confidence","evidence_ref"],"properties":{"hypothesis_id":{"type":"string"},"targets":{"type":"array","items":{"$ref":"#/$defs/target"}},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"evidence_ref":{"type":"string","minLength":1}},"additionalProperties":false},
    "alignment":{"type":"object","required":["alignment_id","page_id","region_ids","targets","relation","status","confidence","hypotheses","review_state","reviewer_id","provenance_ref","depends_on_alignment_ids"],"properties":{"alignment_id":{"type":"string"},"page_id":{"type":"string"},"region_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"targets":{"type":"array","items":{"$ref":"#/$defs/target"}},"relation":{"enum":["one_to_one","one_to_many","many_to_one","ligature","omission","gap","damage","editorial_restoration","unresolved"]},"status":{"enum":["proposed","resolved","disputed","unresolved","unscorable"]},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"hypotheses":{"type":"array","items":{"$ref":"#/$defs/hypothesis"}},"review_state":{"enum":["unreviewed","in_review","reviewed","adjudicated","rejected"]},"reviewer_id":{"type":["string","null"]},"provenance_ref":{"type":"string","minLength":1},"depends_on_alignment_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}},"additionalProperties":false}
  }
}
