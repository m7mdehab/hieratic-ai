{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m7mdehab.github.io/hieratic-ai/schemas/tasks.schema.json",
  "title": "Hieratic AI task graph and progress rules",
  "type": "object",
  "required": ["schema_version", "roadmap_version", "status_values", "phases", "tasks", "rules"],
  "properties": {
    "schema_version": {"type": "string"},
    "roadmap_version": {"type": "string"},
    "status_values": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "phases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["weight"],
        "properties": {
          "weight": {"type": "number"},
          "mandatory_gate": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase", "title", "weight", "status", "depends_on", "acceptance_summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "weight": {"type": "number"},
          "status": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "acceptance_summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "object",
      "required": ["progress"],
      "properties": {
        "progress": {
          "type": "object",
          "required": ["validated_weighted_tasks_expected"],
          "properties": {
            "capability_total": {"type": "number"},
            "validated_weighted_tasks_expected": {"type": "number"},
            "control_plane_tasks_are_unweighted": {"type": "boolean"},
            "only_validated_tasks_earn_points": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
